{
  "name": "bora-estudar",
  "version": "1.1.0",
  "description": "Bora Estudar: app de estudos para concursos com contas e progresso salvo no servidor",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "gen-secrets": "node scripts/gen-secrets.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "banco": "node banco/build.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "express-rate-limit": "8.7.5",
    "helmet": "8.3.0"
  }
}
