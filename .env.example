# Copie para .env (local) ou cadastre estas variáveis no painel da hospedagem.
# NUNCA publique o .env no GitHub.

NODE_ENV=production

# Gere os dois valores abaixo com:  npm run gen-secrets
PEPPER=
DATA_KEY=

# Endereço público do app, com https e sem barra no final.
APP_ORIGIN=https://bora.seudominio.com.br

# Onde ficam o banco e os backups. Precisa ser um disco que NÃO é apagado quando o servidor reinicia.
DATA_DIR=/data

# Quantos proxies existem entre o usuário e o app (Render, Fly, Railway, nginx: 1).
TRUST_PROXY=1

# Porta (a maioria das hospedagens define sozinha)
# PORT=3000
